{
  "name": "dsh-auto-open-web",
  "version": "0.1.2",
  "description": "Open the DSH Web GUI in an app-style WebView2 window on profile start, with a settings card for browser paths",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build:host": "dotnet publish host/DshAppWindow.csproj -c Release -o host-publish --nologo",
    "prepack": "npm run build:host"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/worker.cjs",
    "lib/paths.js",
    "lib/platform.js",
    "lib/win32.js",
    "lib/posix.js",
    "host-publish",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "koffi": "^3.1.4"
  },
  "license": "MIT"
}
